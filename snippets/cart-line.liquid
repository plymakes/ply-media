{%- comment -%} One line in the cart drawer or cart page. Accepts: item, index (1-based line number) {%- endcomment -%}
<div class="line">
  <a class="line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.image.alt, width: 76, height: 76 }}
    {%- endif -%}
  </a>
  <div class="line__body">
    <div class="line__top">
      <a class="line__title" href="{{ item.url }}">{{ item.product.title }}</a>
      <span class="small">{{ item.final_line_price | money_without_trailing_zeros }}</span>
    </div>
    {%- unless item.product.has_only_default_variant -%}
      <span class="line__variant">{{ item.variant.title }}</span>
    {%- endunless -%}
    {%- for discount in item.line_level_discount_allocations -%}
      <span class="line__variant">{{ discount.discount_application.title }}</span>
    {%- endfor -%}
    <div class="line__actions">
      <div class="qty">
        <button
          type="button"
          data-line-change
          data-line="{{ index }}"
          data-quantity="{{ item.quantity | minus: 1 }}"
          aria-label="{{ 'cart.decrease' | t: title: item.product.title }}"
        >
          −
        </button>
        <span>{{ item.quantity }}</span>
        <button
          type="button"
          data-line-change
          data-line="{{ index }}"
          data-quantity="{{ item.quantity | plus: 1 }}"
          aria-label="{{ 'cart.increase' | t: title: item.product.title }}"
        >
          +
        </button>
      </div>
      <button type="button" class="link-button" data-line-change data-line="{{ index }}" data-quantity="0">
        {{- 'cart.remove' | t -}}
      </button>
    </div>
  </div>
</div>
