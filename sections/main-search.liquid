<section class="section--tight">
  <div class="container stack" style="--stack-gap: 28px;">
    <h1 class="h2">{{ 'general.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchQuery">{{ 'general.search' | t }}</label>
      <input id="SearchQuery" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--dark">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="muted">{{ 'general.search_results' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="grid-cards">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, section_id: section.id, heading_level: 2 %}
            {%- else -%}
              <a href="{{ item.url }}" class="h4">{{ item.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>{%- endif -%}
            <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "tag": "div",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
