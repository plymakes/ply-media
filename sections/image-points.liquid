{%- comment -%}
  Image beside a short list of numbered points. Used on the home page for "How the water drains".
{%- endcomment -%}
<section class="section{% if section.settings.band != 'none' %} band-{{ section.settings.band }}{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="container split">
    <div class="points__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '500, 800, 1100, 1400',
            sizes: '(min-width: 990px) 45vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="stack" style="--stack-gap: 20px;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p style="max-width: 34em;">{{ section.settings.text }}</p>
      {%- endif -%}
      <ol class="points__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="points__num" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3 class="h4">{{ block.settings.title }}</h3>
              <p class="muted">{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.note != blank -%}
        <p class="small muted">{{ section.settings.note }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--outline" style="align-self: flex-start;" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with points",
  "tag": "div",
  "class": "section-image-points",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Square works best. Number markers on the image should match the points." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside every planter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How the water drains." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Small note" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "band", "label": "Background", "options": [ { "value": "none", "label": "Bone" }, { "value": "raised", "label": "Raised" }, { "value": "sand", "label": "Sand" } ], "default": "raised" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets other buttons link to this section, e.g. #drainage" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Drainage holes" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Image with points", "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }] }]
}
{% endschema %}
