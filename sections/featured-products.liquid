{%- liquid
  assign products = section.settings.products
  if products == blank and section.settings.collection != blank
    assign products = section.settings.collection.products
  endif
-%}
<section id="shop" class="section">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="grid-cards">
      {%- for product in products limit: section.settings.limit -%}
        {% render 'product-card', product: product, section_id: section.id %}
      {%- else -%}
        <p class="muted">{{ 'products.empty' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "div",
  "class": "section-featured-products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The first collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three pieces, three colours." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick a colour and add it straight to your cart, or take all three as a set." },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 6 },
    { "type": "collection", "id": "collection", "label": "Or use a collection" },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 1, "max": 12, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
