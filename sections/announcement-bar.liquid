{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'accessibility.announcement' | t }}">
    <p>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Cash on delivery · Free delivery from $35"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
