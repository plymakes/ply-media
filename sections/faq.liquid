<section class="section">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2" style="font-size: clamp(30px, 3.6vw, 52px); margin-block-end: 20px;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }} {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Questions",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first answer", "default": true },
    { "type": "checkbox", "id": "structured_data", "label": "Tell Google these are questions and answers", "info": "Use on one page per set of questions.", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Do you deliver everywhere in Lebanon?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Delivery takes 2 to 4 days and costs $5, free on orders from $35.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Questions", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
