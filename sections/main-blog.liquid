{%- paginate blog.articles by 12 -%}
  <section class="section--tight">
    <div class="container stack" style="--stack-gap: 28px;">
      <h1 class="h2">{{ blog.title }}</h1>
      <div class="grid-cards">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="card" style="text-decoration: none; color: var(--ink);">
            {%- if article.image -%}
              <span class="card__media">
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt }}
              </span>
            {%- endif -%}
            <h2 class="h4">{{ article.title }}</h2>
            <span class="small muted">{{ article.published_at | time_tag: format: 'date' }}</span>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>{%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
