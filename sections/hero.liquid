{%- liquid
  assign image = section.settings.image
  if image == blank and section.settings.image_product != blank
    assign image = section.settings.image_product.featured_image
  endif
  assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
-%}
<section class="hero">
  <div class="container split">
    <div class="stack" style="--stack-gap: 24px;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="display">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="lead">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="cluster">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--accent" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.show_whatsapp and wa != blank -%}
          <a
            class="btn btn--outline"
            href="https://wa.me/{{ wa }}?text={{ settings.whatsapp_greeting | url_encode }}"
            rel="noopener"
            target="_blank"
          >
            {{- 'general.order_on_whatsapp' | t -}}
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.note != blank -%}
        <p class="hero__note">{{ section.settings.note }}</p>
      {%- endif -%}
      {%- if section.settings.arabic_line != blank -%}
        <p class="ar-line" lang="ar" dir="rtl" style="align-self: flex-start;">{{ section.settings.arabic_line }}</p>
      {%- endif -%}
    </div>
    <div>
      <div class="hero__media">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ply Makes · 3D-printed in Lebanon" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Use italic for one accent word.", "default": "Textured planters with a hidden drip tray, <em>printed</em> in Lebanon." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Quilt and Tile planters with matching vases, in four calm colours. From $14." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show the WhatsApp button", "default": true },
    { "type": "text", "id": "note", "label": "Small note", "default": "Cash on delivery · Free delivery from $35" },
    { "type": "text", "id": "arabic_line", "label": "Arabic line", "default": "طبقة فوق طبقة، من لبنان" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "image_product", "label": "Use this product's image when no image is set" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
