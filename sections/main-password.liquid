<section class="password-main">
  <div class="container container--narrow stack" style="--stack-gap: 22px; padding-block: 64px;">
    <img src="{{ 'ply-makes-lockup-charcoal.svg' | asset_url }}" alt="{{ shop.name }}" width="100" height="40" style="height: 40px; width: auto;">
    <h1 class="display" style="font-size: clamp(44px, 7vw, 88px);">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="lead">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- render 'signup-form',
      form_id: 'PasswordNewsletter',
      tone: 'light',
      tags: 'newsletter, prelaunch',
      label: section.settings.newsletter_label,
      button: section.settings.button,
      after_note: section.settings.after_note,
      show_apply: false
    -%}
    {%- if settings.instagram_url != blank -%}
      <a href="{{ settings.instagram_url }}" rel="noopener" target="_blank" style="font-weight: 500; align-self: flex-start;">{{ 'general.follow_instagram' | t }}</a>
    {%- endif -%}
    <details style="margin-block-start: 24px;">
      <summary class="small muted" style="cursor: pointer;">{{ 'general.password_enter' | t }}</summary>
      {%- form 'storefront_password', class: 'stack', id: 'StorePassword' -%}
        <label class="field" for="StorePasswordInput">
          {{- 'general.password' | t -}}
          <input id="StorePasswordInput" type="password" name="password" autocomplete="current-password">
        </label>
        {%- if form.errors -%}
          <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <button type="submit" class="btn btn--outline" style="align-self: flex-start;">{{ 'general.password_submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Textured planters and vases with a hidden drip tray, 3D-printed in Lebanon. Leave your email and we'll tell you the day we open." },
    { "type": "text", "id": "newsletter_label", "label": "Email label (when no offer runs)", "default": "Be first in line" },
    { "type": "text", "id": "button", "label": "Button", "default": "Join the list" },
    { "type": "text", "id": "after_note", "label": "Line under the code after a signup", "default": "Use it at checkout when we open. We'll email you on opening day." }
  ]
}
{% endschema %}
