{%- assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
<section class="band-clay section--tight">
  <div class="container split" style="justify-content: space-between;">
    <div class="stack" style="--stack-gap: 10px;">
      <h2 class="h2" style="font-size: clamp(28px, 3vw, 40px);">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="stack" style="--stack-gap: 8px; align-items: flex-start; flex: 0 1 320px;">
      {%- if wa != blank -%}
        <a class="btn btn--dark" href="https://wa.me/{{ wa }}?text={{ settings.whatsapp_greeting | url_encode }}" rel="noopener" target="_blank">
          {{- 'general.order_on_whatsapp' | t -}}
        </a>
        <span class="small">+{{ wa }}</span>
      {%- elsif settings.instagram_url != blank -%}
        <a class="btn btn--dark" href="{{ settings.instagram_url }}" rel="noopener" target="_blank">{{ 'general.message_on_instagram' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WhatsApp band",
  "tag": "div",
  "class": "section-whatsapp",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rather order by message?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Send us the piece and colour on WhatsApp and we take it from there." }
  ],
  "presets": [{ "name": "WhatsApp band" }]
}
{% endschema %}
