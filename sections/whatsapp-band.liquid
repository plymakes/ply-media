{%- comment -%}
  Message band. Sends people to an Instagram DM. If a WhatsApp number is ever set again in
  Theme settings › WhatsApp, a WhatsApp button shows too. (v2.3, 21 Oct 2026: WhatsApp paused.)
{%- endcomment -%}
{%- liquid
  assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign dm = settings.instagram_dm_url | default: settings.instagram_url
-%}
<section class="band-clay section--tight">
  <div class="container split" style="justify-content: space-between;">
    <div class="stack" style="--stack-gap: 10px;">
      <h2 class="h2" style="font-size: clamp(28px, 3vw, 40px);">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="stack" style="--stack-gap: 8px; align-items: flex-start; flex: 0 1 320px;">
      {%- if dm != blank -%}
        <a class="btn btn--dark" href="{{ dm }}" rel="noopener" target="_blank">{{ section.settings.button }}</a>
        <span class="small">Instagram @plymakes</span>
      {%- endif -%}
      {%- if wa != blank -%}
        <a class="btn btn--outline" href="https://wa.me/{{ wa }}?text={{ settings.whatsapp_greeting | url_encode }}" rel="noopener" target="_blank">
          {{- 'general.order_on_whatsapp' | t -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Message band",
  "tag": "div",
  "class": "section-whatsapp",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rather order by message?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Send us a DM on Instagram with the piece and colour, and we take it from there." },
    { "type": "text", "id": "button", "label": "Button", "default": "Send us a DM" }
  ],
  "presets": [{ "name": "Message band" }]
}
{% endschema %}
