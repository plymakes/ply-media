{%- liquid
  assign product = section.settings.product
-%}
{%- if product != blank -%}
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign image = variant.featured_image | default: product.featured_image
    assign form_id = 'bundle-' | append: section.id
  -%}
  <section class="band-sand section--tight">
    <div class="container bundle" data-product-scope>
      {%- if image -%}
        <a class="bundle__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
          {{
            image
            | image_url: width: 800
            | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 300px, 80vw', alt: image.alt, class: 'js-card-image'
          }}
        </a>
      {%- endif -%}
      <div class="bundle__copy stack" style="--stack-gap: 12px;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="h2" style="font-size: clamp(30px, 3.4vw, 48px);">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p style="max-width: 34em;">{{ section.settings.text }}</p>
        {%- endif -%}
        <p class="price" style="font-size: 22px;">
          <span class="serif" data-price>{{ variant.price | money_without_trailing_zeros }}</span>
          <s
            class="price__compare"
            data-compare-price
            {% unless variant.compare_at_price > variant.price %}
              hidden
            {% endunless %}
          >
            {{- variant.compare_at_price | money_without_trailing_zeros -}}
          </s>
          {%- if section.settings.price_note != blank -%}
            <span class="price__save">{{ section.settings.price_note }}</span>
          {%- endif -%}
        </p>
      </div>
      <div class="bundle__buy">
        <product-form>
          {%- form 'product', product, id: form_id, class: 'stack', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ variant.id }}" data-variant-input>
            <input type="hidden" name="quantity" value="1">
            {% render 'variant-picker', product: product, form_id: form_id, large: true %}
            <button
              type="submit"
              class="btn btn--dark btn--block btn--lg"
              data-add-button
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
              <span data-add-label>{{ 'products.add_the_set' | t }}</span>
              <span aria-hidden="true">·</span>
              <span data-price>{{ variant.price | money_without_trailing_zeros }}</span>
            </button>
            <p class="form-error" data-form-error role="alert" hidden></p>
          {%- endform -%}
        </product-form>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Bundle",
  "tag": "div",
  "class": "section-bundle",
  "settings": [
    { "type": "product", "id": "product", "label": "Bundle product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The set of three" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A medium planter and its matching vase." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick a texture and a colour and we pack the two together. An easy housewarming gift." },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "Free delivery" }
  ],
  "presets": [{ "name": "Bundle" }]
}
{% endschema %}
