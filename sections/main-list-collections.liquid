<section class="section--tight">
  <div class="container stack" style="--stack-gap: 28px;">
    <h1 class="h2">{{ 'general.collections' | t }}</h1>
    <div class="grid-cards">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="card" style="text-decoration: none; color: var(--ink);">
          <span class="card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: collection.title }}
            {%- endif -%}
          </span>
          <h2 class="h4">{{ collection.title }}</h2>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "class": "section-main-list-collections",
  "settings": []
}
{% endschema %}
