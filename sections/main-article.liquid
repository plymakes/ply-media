<article class="section--tight">
  <div class="container container--narrow stack" style="--stack-gap: 20px;">
    <p class="small muted">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h2">{{ article.title }}</h1>
    {%- if article.image -%}
      <div style="border-radius: var(--radius-md); overflow: hidden;">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 900px, 100vw', alt: article.image.alt }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
