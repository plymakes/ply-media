<section class="band-raised section--tight">
  <div class="container stack" style="--stack-gap: 32px;">
    <h2 class="h2" style="font-size: clamp(30px, 3.6vw, 52px);">{{ section.settings.heading }}</h2>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="steps__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <p style="font-size: 15px;">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "tag": "div",
  "class": "section-steps",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our printer to your door." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Order here or on WhatsApp" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "No account needed. Just your name, phone and address." }
      ]
    }
  ],
  "presets": [{ "name": "Steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
