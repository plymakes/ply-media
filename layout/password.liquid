<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#EFEAE2">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'ply-favicon.svg' | asset_url }}">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {{ 'fraunces-latin-500-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: "Fraunces"; font-style: normal; font-weight: 500; font-display: swap; src: url("{{ 'fraunces-latin-500-normal.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Space Grotesk"; font-style: normal; font-weight: 400; font-display: swap; src: url("{{ 'space-grotesk-latin-400-normal.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Space Grotesk"; font-style: normal; font-weight: 500 700; font-display: swap; src: url("{{ 'space-grotesk-latin-500-normal.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Noto Naskh Arabic"; font-style: normal; font-weight: 600 700; font-display: swap; src: url("{{ 'noto-naskh-arabic-arabic-600-normal.woff2' | asset_url }}") format("woff2"); }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="password-page">
    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
